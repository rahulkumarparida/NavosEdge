# ==============================================================================
# NavosEdge Deployment Configuration
# ==============================================================================

# -------------------------
# 1. Intelligence Server
# -------------------------
NAVOS_HOST=0.0.0.0
NAVOS_PORT=8420
NAVOS_LOG_LEVEL=INFO

# -------------------------
# 2. Directories
# -------------------------
# Set these to standard Linux paths for production (e.g., /var/lib/navosedge/data)
# or keep them relative for development/local testing.
NAVOS_DATA_DIR=./data
NAVOS_ARTIFACTS_DIR=./artifacts
NAVOS_FORECAST_STORAGE_DIR=./data/forecast
NAVOS_AQI_STORAGE_FILE=./data/aqi_latest.json

# -------------------------
# 3. Hardware Client
# -------------------------
NAVOS_NODE_ID=uno-q-prod-01
NAVOS_SENSOR_INTERVAL=10
NAVOS_SENSOR_MODE=physical
NAVOS_SCENARIO=normal
# Physical sensor serial/monitor transport:
# • For Arduino UNO Q onboard sensors (streamed via arduino-router monitor proxy): 127.0.0.1:7500
# • For external USB Arduino on desktop: /dev/ttyACM0 or /dev/ttyUSB0
NAVOS_SERIAL_PORT=127.0.0.1:7500
NAVOS_SERIAL_BAUD=115200

# -------------------------
# 4. Parent Manager Server & UNO Q Polling
# -------------------------
NAVOS_MANAGER_HOST=0.0.0.0
NAVOS_MANAGER_PORT=8430

# UNO Q Edge Node IP / Address (configured for Wi-Fi network deployment)
# Specify either NAVOS_UNO_Q_IP + NAVOS_UNO_Q_PORT or direct NAVOS_UNO_Q_URL
NAVOS_UNO_Q_IP=127.0.0.1
NAVOS_UNO_Q_PORT=8420
# NAVOS_UNO_Q_URL=http://192.168.1.50:8420

# Polling Interval in seconds (default: 3600 = 1 hour)
NAVOS_POLL_INTERVAL_S=3600
NAVOS_POLL_ENABLED=true


