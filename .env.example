# ==============================================================================
# NavosEdge Deployment Configuration (Template — Copy to .env and fill values)
# ==============================================================================

# -------------------------
# 1. Runtime Mode & Security
# -------------------------
# development | production
NAVOS_ENV=development
# Comma-separated trusted origins for CORS (restrict in production, e.g. http://192.168.1.50:8430)
NAVOS_CORS_ORIGINS=*
# Shared operator/manager API key (REQUIRED when NAVOS_ENV=production)
NAVOS_MANAGER_API_KEY=replace-with-strong-random-manager-api-key

# -------------------------
# 2. Intelligence Server (UNO Q)
# -------------------------
NAVOS_HOST=0.0.0.0
NAVOS_PORT=8420
NAVOS_LOG_LEVEL=INFO

# -------------------------
# 3. Directories & Emergency SQLite Database
# -------------------------
# Set these to standard Linux paths for production (e.g., /var/lib/navosedge/data)
# or keep them relative for development/local testing.
NAVOS_DATA_DIR=./data
NAVOS_ARTIFACTS_DIR=./artifacts
NAVOS_FORECAST_STORAGE_DIR=./data/forecast
NAVOS_AQI_STORAGE_FILE=./data/aqi_latest.json
NAVOS_EMERGENCY_DB_PATH=./data/navos_emergency.db

# -------------------------
# 4. Hardware Client (UNO Q Edge Node)
# -------------------------
NAVOS_NODE_ID=uno-q-prod-01
NAVOS_SENSOR_INTERVAL=10
NAVOS_SENSOR_MODE=physical
NAVOS_SCENARIO=normal
# Physical sensor serial/monitor transport:
# - For Arduino UNO Q onboard sensors (streamed via arduino-router monitor proxy): 127.0.0.1:7500
# - For external USB Arduino on desktop: /dev/ttyACM0 or /dev/ttyUSB0
NAVOS_SERIAL_PORT=127.0.0.1:7500
NAVOS_SERIAL_BAUD=115200

# -------------------------
# 5. Parent Manager Server & UNO Q Polling
# -------------------------
NAVOS_MANAGER_HOST=0.0.0.0
NAVOS_MANAGER_PORT=8430

# UNO Q Edge Node IP / Address (configured for Wi-Fi network deployment)
# Specify either NAVOS_UNO_Q_IP + NAVOS_UNO_Q_PORT or direct NAVOS_UNO_Q_URL
NAVOS_UNO_Q_IP=10.103.68.140
NAVOS_UNO_Q_PORT=8420
NAVOS_UNO_Q_URL=http://10.103.68.140:8420

# Polling Interval in seconds (default: 3600 = 1 hour)
NAVOS_POLL_INTERVAL_S=3600
NAVOS_POLL_ENABLED=true

# Navos multi language advisory (or/hn/en)
NAVOS_ADVISORY_LANGUAGE=en

# -------------------------
# 6. Hazard Policy Engine (Phase 2)
# -------------------------
NAVOS_HAZARD_AQI_STANDARD=IN
NAVOS_HAZARD_UNCERTAINTY_THRESHOLD=0.60
NAVOS_HAZARD_MIN_CLASS_CONFIDENCE=0.65
NAVOS_HAZARD_STALE_DATA_SECONDS=300.0
NAVOS_HAZARD_SUDDEN_PM25_DELTA_UGM3=35.0
NAVOS_HAZARD_SUDDEN_PM10_DELTA_UGM3=75.0
NAVOS_HAZARD_SUDDEN_MQ_DELTA_V=0.80
NAVOS_HAZARD_PERSISTENT_MIN_READINGS=3
NAVOS_HAZARD_RECOVERY_MIN_READINGS=2

# -------------------------
# 7. ESP32 Wireless Actuator Integration (Phase 3)
# -------------------------
NAVOS_ACTUATOR_HTTP_PORT=8080
NAVOS_ACTUATOR_COMMAND_TIMEOUT_S=5.0
NAVOS_ACTUATOR_HEARTBEAT_STALE_S=90.0
NAVOS_ACTUATOR_DUPLICATE_WINDOW_S=30.0
NAVOS_ACTUATOR_DEFAULT_LEASE_S=60
NAVOS_ACTUATOR_DEMO_MODE=false

# -------------------------
# 8. Twilio Emergency Notification & Escalation (Phase 4)
# -------------------------
# SIMULATED | LIVE
NAVOS_TWILIO_MODE=SIMULATED
# REST (Direct Twilio Messages + Calls API; zero Studio setup, great for Trial)
# | STUDIO (Single authenticated POST to Twilio Studio Flow Executions API)
NAVOS_TWILIO_DISPATCH_MODE=REST
NAVOS_TWILIO_ACCOUNT_SID=
NAVOS_TWILIO_AUTH_TOKEN=
NAVOS_TWILIO_FROM_NUMBER=
# Optional Twilio Studio Flow SID (FW...); required only when NAVOS_TWILIO_DISPATCH_MODE=STUDIO in LIVE mode
NAVOS_TWILIO_STUDIO_FLOW_SID=
# Public HTTPS URL for Twilio webhook callbacks (required when NAVOS_TWILIO_MODE=LIVE)
NAVOS_PUBLIC_WEBHOOK_BASE_URL=
# HMAC signing secret for caregiver acknowledgement links (MUST be changed in production)
NAVOS_ACK_SIGNING_SECRET=navosedge-local-dev-ack-secret-change-in-prod
NAVOS_TWILIO_TIMEOUT_S=10.0
NAVOS_TWILIO_MAX_RETRIES=2
NAVOS_TWILIO_RETRY_BACKOFF_S=0.25
# Verify X-Twilio-Signature header on incoming webhooks (keep true in LIVE mode)
NAVOS_TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true
# Free-tier / Twilio Trial compatibility:
# - true: skips paid MachineDetection upfront, checks optional verified allowlist, adds clear 21219/21608 hints
# - false: full paid Twilio account mode
NAVOS_TWILIO_TRIAL_MODE=true
# Optional comma-separated E.164 verified recipient numbers allowed in Trial LIVE mode (leave blank to skip local pre-check)
NAVOS_TWILIO_VERIFIED_NUMBERS=
# Optional default verified E.164 recipients used by single-request test workflow / scripts
NAVOS_TWILIO_TEST_RECIPIENT=
NAVOS_TWILIO_SECONDARY_RECIPIENT=
NAVOS_ESCALATION_ACK_TIMEOUT_S=120.0
NAVOS_ESCALATION_DEMO_TIMEOUT_S=30.0
NAVOS_ESCALATION_DEMO_MODE=false
