# NavosEdge Intelligence Server Configuration
# Copy to .env and modify as needed

# Server
NAVOS_HOST=0.0.0.0
NAVOS_PORT=8420
NAVOS_LOG_LEVEL=INFO

# Storage — paths relative to Intelligence/Server/ or absolute
NAVOS_DATA_DIR=./data
NAVOS_ARTIFACTS_DIR=./artifacts

# File rotation
NAVOS_STORAGE_MAX_FILE_SIZE_MB=50.0
NAVOS_STORAGE_MAX_FILES_PER_NODE=30

# SSE
NAVOS_SSE_HEARTBEAT_INTERVAL_S=15.0

# Request limits
NAVOS_MAX_PAYLOAD_BYTES=65536

# Model artifacts (filenames, looked up inside ARTIFACTS_DIR)
# Gas classifier model
NAVOS_MODEL_WEIGHTS_FILE=gasnet.pt
NAVOS_MODEL_PREPROCESS_FILE=preprocess.pkl
